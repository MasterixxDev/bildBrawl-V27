# Конвертер тега в lowID
async def tag2id(tag):
    TagChar = ("0","2","8","9","P","Y","L","Q","G","R","J","C","U","V")
    Id = 0
    for c in tag.upper():
        if c not in TagChar: return None
        Id = Id * len(TagChar) + TagChar.index(c)
    return (Id - Id % 256) >> 8

# Синхронная обёртка для асинхронной функции
def tag_to_lowid(tag):
    return asyncio.run(tag2id(tag))

# Сериализатор для datetime
def json_serializer(obj):
    if isinstance(obj, datetime.datetime):
        return obj.isoformat()
    raise TypeError(f"Object of type {type(obj)} is not JSON serializable")

def is_admin(user_id):
    return user_id in ADMIN_IDS

# Утилита для загрузки данных из JSON
def load_json(path, default):
    if os.path.exists(path):
        with open(path, 'r', encoding='utf-8') as f:
            return json.load(f)
    return default

# Утилита для сохранения
def save_json(path, data):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


# Создадим файл, если его нет
if not os.path.exists(PROMO_FILE_PATH):
    with open(PROMO_FILE_PATH, 'w', encoding='utf-8') as f:
        json.dump([], f, ensure_ascii=False, indent=2)

@bot.message_handler(commands=['promo'])
def add_promo_code(message):
    if not is_admin(message.from_user.id):
        bot.reply_to(message, "❌ У вас нет прав для выполнения этой команды!")
        return

    try:
        args = message.text.split()
        if len(args) != 4:
            bot.reply_to(message, 
                "Формат:\n"
                "/promo skin <skinID> <id>\n"
                "/promo gems <amount> <id>\n\n"
                "Примеры:\n"
                "/promo skin 52 release\n"
                "/promo gems 500 summer25"
            )
            return

        _, ptype, value_str, code_id = args

        if ptype not in ('skin', 'gems'):
            bot.reply_to(message, "❌ Тип должен быть 'skin' или 'gems'.")
            return

        try:
            value = int(value_str)
            if value <= 0:
                raise ValueError
        except ValueError:
            bot.reply_to(message, "❌ Значение должно быть положительным числом.")
            return

        # Загружаем текущие коды
        with open(PROMO_FILE_PATH, 'r', encoding='utf-8') as f:
            codes = json.load(f)

        # Проверка дубликата
        if any(c.get('id') == code_id for c in codes):
            bot.reply_to(message, f"❌ Промокод с ID '{code_id}' уже существует!")
            return

        # Создаём новый код
        if ptype == 'skin':
            new_code = {
                "id": code_id,
                "type": "skin",
                "skinID": value
            }
        else:  # gems
            new_code = {
                "id": code_id,
                "type": "gems",
                "amount": value
            }

        # Добавляем и сохраняем
        codes.append(new_code)
        with open(PROMO_FILE_PATH, 'w', encoding='utf-8') as f:
            json.dump(codes, f, ensure_ascii=False, indent=2)

        bot.reply_to(message, f"✅ Промокод создан!\n"
                              f"ID: `{code_id}`\n"
                              f"Тип: `{ptype}`\n"
                              f"Значение: `{value}`", parse_mode="Markdown")

        logging.info(f"[PROMO] Админ {message.from_user.id} создал промокод: {new_code}")

    except Exception as e:
        logging.error(f"[PROMO ERROR] {e}")
        bot.reply_to(message, f"❌ Ошибка: {e}")

@bot.message_handler(commands=['notify'])
def send_global_notification(message):
    if not is_admin(message.from_user.id):
        bot.reply_to(message, "❌ У вас нет прав для выполнения этой команды!")
        return

    try:
        # Получаем текст после команды
        text = message.text[8:].strip()  # "/notify " = 8 символов
        if not text:
            bot.reply_to(message, "❌ Укажите текст уведомления.\nПример: /notify Добро пожаловать!")
            return

        # Подтверждение (опционально)
        bot.reply_to(message, f"📤 Отправляю уведомление всем игрокам:\n\n\"{text}\"")

        # Получаем всех игроков
        players = list(accounts.find({}, {'lowID': 1}))
        total = len(players)

        if total == 0:
            bot.reply_to(message, "⚠️ Нет игроков в базе.")
            return

        # Формируем уведомление
        notification = {
            'NotificationID': 81,
            'NotificationRead': False,
            'NotificationTime': int(datetime.datetime.now().timestamp()),
            'NotificationText': text,
            'NotificationType': 0
        }

        # Обновляем каждого игрока
        success = 0
        for player in players:
            try:
                accounts.update_one(
                    {'lowID': player['lowID']},
                    {
                        '$push': {
                            'notifications': {
                                '$each': [notification],
                                '$slice': -50
                            }
                        }
                    }
                )
                success += 1
            except Exception as e:
                logging.error(f"[NOTIFY] Ошибка для lowID {player['lowID']}: {e}")

        bot.send_message(
            message.chat.id,
            f"✅ Уведомление отправлено {success} из {total} игроков.\n"
            f"Текст: \"{text}\""
        )
        logging.info(f"[GLOBAL NOTIFY] Отправлено {success} игрокам. Текст: {text}")

    except Exception as e:
        logging.error(f"[NOTIFY ERROR] {e}")
        bot.reply_to(message, f"❌ Ошибка при отправке уведомления: {e}")

@bot.message_handler(commands=['backup'])
def cmd_backup(message):
    if not is_admin(message.from_user.id):
        bot.reply_to(message, "❌ У вас нет прав для выполнения этой команды!")
        return

    try:
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        filename = f"backups/backup_{timestamp}.json"

        accounts_data = list(accounts.find({}))
        for doc in accounts_data:
            doc.pop('_id', None)

        with open(filename, 'w', encoding='utf-8') as f:
            json.dump(accounts_data, f, ensure_ascii=False, indent=2, default=json_serializer)

        with open(filename, 'rb') as f:
            bot.send_document(
                message.chat.id,
                f,
                caption=f"✅ Резервная копия создана!\n"
                        f"📁 Файл: `{filename}`\n"
                        f"👥 Аккаунтов: {len(accounts_data)}",
                parse_mode="Markdown"
            )
        logging.info(f"[BACKUP] Создана резервная копия: {filename}")

    except Exception as e:
        logging.error(f"[BACKUP ERROR] {e}")
        bot.reply_to(message, f"❌ Ошибка при создании бекапа: {e}")

@bot.message_handler(commands=['gems'])
def give_gems(message):
    if not is_admin(message.from_user.id):
        bot.reply_to(message, "❌ У вас нет прав для выполнения этой команды!")
        return

    try:
        args = message.text.split()
        if len(args) != 3:
            bot.reply_to(message, "Формат: /gems <тег> <количество>")
            return

        tag = args[1]
        amount = int(args[2])

        # Конвертируем тег в lowID
        low_id = tag_to_lowid(tag)
        if low_id is None:
            bot.reply_to(message, "❌ Неверный формат тега!")
            return

        if amount <= 0:
            bot.reply_to(message, "❌ Количество гемов должно быть больше 0.")
            return

        user = accounts.find_one({'lowID': low_id})
        if not user:
            bot.reply_to(message, f"❌ Аккаунт с тегом {tag} не найден.")
            return

        # Создаём уведомление
        gem_notification = {
            'NotificationID': 89,
            'NotificationRead': False,
            'NotificationTime': int(datetime.datetime.now().timestamp()),
            'NotificationText': 'спасибо за донат',
            'Gems': amount
        }

        # Добавляем уведомление в конец списка (не более 50 последних)
        accounts.update_one(
            {'lowID': low_id},
            {
                '$push': {
                    'notifications': {
                        '$each': [gem_notification],
                        '$slice': -50
                    }
                }
            }
        )

        bot.reply_to(message, f"✅ Пользователю {tag} (lowID: {low_id}) отправлено {amount} гемов через уведомление!")

    except ValueError:
        bot.reply_to(message, "❌ Неверный формат. Используйте: /gems <тег> <число>")
    except Exception as e:
        logging.error(f"[GEMS ERROR] {e}")
        bot.reply_to(message, f"❌ Ошибка: {e}")


// После создания rl добавьте обработчик команд
rl.on('line', async (input) => {
    const args = input.trim().split(' ');
    const command = args[0].toLowerCase();

    switch (command) {
        case 'resetseason':
            console.log('🔄 Запуск ручного сброса сезона...');
            const seasonReset = new SeasonReset();
            await seasonReset.resetAllPlayersSeason();
            await seasonReset.updateLastResetTime();
            console.log('✅ Ручной сброс сезона завершен');
            break;
            
        case 'checkseason':
            const seasonReset = new SeasonReset();
            const shouldReset = await seasonReset.shouldResetSeason();
            console.log(`📅 До сброса сезона: ${shouldReset ? 'ПОРА' : 'ЕЩЕ РАНО'}`);
            break;
            
        case 'help':
            console.log('📋 Доступные команды:');
            console.log('  resetseason - ручной сброс сезона');
            console.log('  checkseason - проверить статус сброса');
            console.log('  help - показать это сообщение');
            break;
            
        default:
            console.log(`❌ Неизвестная команда: ${command}. Введите "help" для списка команд.`);
            break;
    }
});